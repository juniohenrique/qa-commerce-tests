{
  "name": "qa-commerce-tests",
  "version": "1.0.0",
  "description": "Testes automatizados para a aplicação QA Commerce utilizando Cypress + Cucumber",
  "type": "commonjs",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:web": "cypress run --spec 'cypress/e2e/features/web/**/*.feature'",
    "test:api": "cypress run --spec 'cypress/e2e/features/api/**/*.feature'",
    "test": "cypress run"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.3.0",
    "cypress": "^15.11.0",
    "esbuild": "^0.27.3"
  }
}
